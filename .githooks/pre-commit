#!/usr/bin/env bash
# Activation : git config core.hooksPath .githooks
set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "${REPO_ROOT}"
SOURCES=(assets/fiche-formateur.md assets/fiche-formateur-print.css scripts/build-pdf.sh)
TARGET_PDF="assets/fiche-formateur.pdf"
NEEDS_BUILD=false

# Le CSS et le générateur sont des sources au même titre que le Markdown.
for source in "${SOURCES[@]}"; do
  [[ -f "${source}" ]] || { printf 'Source de la fiche absente : %s\n' "${source}" >&2; exit 1; }
  if [[ ! -f "${TARGET_PDF}" || "${source}" -nt "${TARGET_PDF}" ]]; then
    NEEDS_BUILD=true
  fi
done
if ! git diff --cached --quiet -- "${SOURCES[@]}"; then
  NEEDS_BUILD=true
fi
[[ "${NEEDS_BUILD}" == true ]] || exit 0

# Ne pas embarquer dans le PDF du contenu absent de l’index ou partiellement stagé.
for source in "${SOURCES[@]}"; do
  if ! git cat-file -e ":${source}" 2>/dev/null || ! git diff --quiet -- "${source}"; then
    printf 'Fiche non générée : ajoute entièrement %s à l’index avant le commit.\n' "${source}" >&2
    exit 1
  fi
done

"${REPO_ROOT}/scripts/build-pdf.sh"
git add -- "${TARGET_PDF}"
printf 'Fiche publique régénérée et ajoutée au commit.\n'
